# Dépendances (le dossier le plus lourd à NE PAS envoyer)
node_modules/
jspm_packages/

# Fichiers d'environnement (contiennent tes mots de passe/clés secrètes)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dossiers de build / production (générés automatiquement)
dist/
build/
.next/
out/

# Fichiers systèmes inutiles
.DS_Store
Thumbs.db

# Logs d'erreurs de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dossiers de configuration de ton éditeur (optionnel mais conseillé)
.vscode/
.idea/